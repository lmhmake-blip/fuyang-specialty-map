.gift {
  margin: 0 20px 16px; border-radius: 16px; background: var(--surface);
  box-shadow: var(--shadow-1); overflow: hidden;
}
.gift-bar { height: 6px; }
.gift-body { padding: 16px 16px 18px; }
.gift-head { display: flex; align-items: center; margin-bottom: 6px; }
.gift-name {
  font-family: var(--serif); font-weight: 700; font-size: 19px; margin-right: 9px;
}
.gift-desc { font-size: 12.5px; color: var(--ink-2); line-height: 1.7; margin-bottom: 13px; }
.gift-items { display: flex; flex-wrap: wrap; margin-bottom: 14px; }
.gift-item {
  font-size: 11px; color: var(--ink-2); background: var(--line-2);
  padding: 3px 9px; border-radius: 4px; margin: 0 6px 6px 0;
}
.gift-foot {
  display: flex; align-items: center;
  padding-top: 13px; border-top: 1px solid var(--line-2);
}
.btn-sm { flex: none; width: auto; height: 38px; padding: 0 20px; font-size: 13.5px; margin-left: auto; }
.gift-specs-wrap { padding: 0 20px 20px; }
