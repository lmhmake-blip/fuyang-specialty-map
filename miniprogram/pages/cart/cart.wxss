.cart-remove { align-self: center; color: var(--ink-3); font-size: 12px; padding: 6px 2px; }
.price-unit { font-size: 10.5px; color: var(--ink-3); margin-left: 6px; }
.empty { padding: 80px 20px; text-align: center; }
